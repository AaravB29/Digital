{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app window may do: save files the user picks, keep daily backups in Documents, open links and the backup folder.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$DOCUMENT/Budget Tracker Backups" }, { "path": "$DOCUMENT/Budget Tracker Backups/**" }]
    },
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$DOCUMENT/Budget Tracker Backups" }]
    }
  ]
}
